# Documentación e investigaciones (locales)
# /docs/* (glob on children, not the dir itself) lets us re-include the wiki below.
/docs/*
# Exception: the wiki is the single public documentation folder tracked in git
!docs/MillenniumDB.wiki/
!docs/MillenniumDB.wiki/**

# Empirical-research notes + raw bench outputs (Spec C3 etc.). Small text/CSV
# files documenting why design decisions were made. Persisted in-repo so
# they survive a celebi disk failure without depending on Desktop scratch dirs.
# To allow nested patterns, first un-ignore the parent dir, then re-ignore
# everything inside, then carve out specific date-prefixed subdirs.
!docs/research/
docs/research/*
!docs/research/2026-05-*/
!docs/research/2026-05-*/**

# Ideas y borradores locales
/Partial_Idea/

# Claude Code configuration (local)
/.claude/
/CLAUDE.md
/.cclsp.json
/.mcp.json

# Doxygen
/Doxyfile

# Third-party dependencies (see third_party/DEPENDENCIES.md for installation)
# Only antlr4-runtime-4.13.1 is tracked in the repository
/third_party/*
!/third_party/antlr4-runtime-4.13.1/
!/third_party/DEPENDENCIES.md

